<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ProtocolGeneratedDirectory Condition="'$(ProtocolGeneratedDirectory)' == ''">../../generated/csharp</ProtocolGeneratedDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0" PrivateAssets="all" IncludeAssets="none" />
    <Compile Include="$(ProtocolGeneratedDirectory)/*.cs" />
  </ItemGroup>
</Project>
