# Deployment tool settings. Server values stay in .env.docker-test.
# Empty: inspect the selected context and allow only a local unix/npipe endpoint.
# Windows Docker Desktop usually uses desktop-linux; Linux usually uses default.
DOCKER_CONTEXT=
IMAGE_NAME=escape-server:lan-test
CONTAINER_NAME=escape-server-lan-test
RUNTIME_ENV_FILE=.env.docker-test
BIND_ADDRESS=0.0.0.0
HOST_PORT=3001
CONTAINER_PORT=3000
RESTART_POLICY=no
# Empty: derive the local /health URL from the published port.
PUBLIC_HEALTH_URL=
HEALTH_TIMEOUT_MS=30000
HEALTH_INTERVAL_MS=500
HEALTH_REQUEST_TIMEOUT_MS=2000
STOP_TIMEOUT_MS=10000
