# Run on your PC. Docker builds and runs on the SSH target engine.
# Required, e.g. ssh://deploy@203.0.113.10 or ssh://escape-cloud (SSH config alias).
# Configure SSH identity/host verification in ~/.ssh/config, not in this file.
SSH_TARGET=
IMAGE_NAME=escape-server:cloud
CONTAINER_NAME=escape-server-cloud
RUNTIME_ENV_FILE=.env.docker-cloud
BIND_ADDRESS=0.0.0.0
HOST_PORT=3000
CONTAINER_PORT=3000
RESTART_POLICY=unless-stopped
# Docker 로그: 파일당 MB, 최대 보관 파일 수. 초과하면 오래된 로그부터 제거합니다.
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=3
# Required: an actual address reachable from your PC, e.g. http://203.0.113.10:3000/health
PUBLIC_HEALTH_URL=
HEALTH_TIMEOUT_MS=30000
HEALTH_INTERVAL_MS=500
HEALTH_REQUEST_TIMEOUT_MS=2000
STOP_TIMEOUT_MS=10000
